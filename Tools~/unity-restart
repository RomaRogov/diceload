#!/usr/bin/env bash
# unity-restart    stop the Unity Editor of this project and open the project again — the last resort when
#                  it's blocked and unity-dialog can't answer what blocks it. What only the Editor held
#                  (unsaved changes) is lost; scenes and prefabs with text twins are in their files.
#                  Needs bash and the unity CLI only: macOS, Linux, and Windows in Git Bash.
set -u
project=${UNITY_PROJECT_PATH:-$PWD}
unity close --force --timeout 20 "$project" >/dev/null 2>&1 && echo "stopped the Editor"
unity open "$project" >/dev/null 2>&1
if unity status --project-path "$project" --until-ready --timeout 300 >/dev/null 2>&1; then echo "the Editor is open again"; exit 0; fi
echo "the Editor didn't come back within 5 minutes"; exit 1
