#!/usr/bin/env bash
# unity-test FILTER [playmode|editmode] [MINUTES]
#   Run tests (simulations: playmode, the default) in the open Editor and wait for them, in one call.
#   It compiles what changed first. The Editor does the work (Diceload.TestRun): it saves unsaved work, so the Test Framework doesn't ask;
#   says why when no test matches; runs; and writes the outcome as plain text to
#   Library/Diceload/test-run.txt — the summary, each failure, each test's SimulationResults folder —
#   which this prints.
#   Exit: 0 ran, 2 not ready, 3 the Editor isn't answering (see unity-dialog), 4 still running, 5 no test.
#   Needs bash and the unity CLI only: macOS, Linux, and Windows in Git Bash.
set -u
filter=${1:?usage: unity-test FILTER [playmode|editmode] [MINUTES]}; mode=${2:-playmode}; minutes=${3:-15}
here=$(cd "$(dirname "$0")" && pwd)
report=${UNITY_PROJECT_PATH:-$PWD}/Library/Diceload/test-run.txt

not_answering() { echo "the Editor isn't answering: run $here/unity-dialog to see what it waits on"; exit 3; }

# What was edited since the last compile is compiled first: otherwise the run is of the old code, silently.
compiled=$(unity recompile 2>&1)
if printf '%s\n' "$compiled" | grep -q '^error'; then
  echo "the project doesn't compile:"; printf '%s\n' "$compiled" | grep '^error' | head -n 20; exit 2
fi

quoted=${filter//\\/\\\\}; quoted=${quoted//\"/\\\"}
answer=$(unity command --timeout 60 script eval --code "return Diceload.TestRun.Start(\"$quoted\", \"$mode\");" --result-only 2>&1)
run=$(printf '%s' "$answer" | grep -o 'run-[0-9]\{17\}' | head -n 1)
if [ -z "$run" ]; then
  case $answer in
    *EDITOR_NOT_RUNNING*) echo "no Editor has this project open: unity open ."; exit 2 ;;
    ""|*"did not start within"*|*[Tt]imed\ out*|*TIMEOUT*) not_answering ;;
    *) echo "couldn't start the run:"; printf '%s\n' "$answer" | head -n 20; exit 2 ;;
  esac
fi

# Entering and leaving Play mode reloads scripts: a few polls the Editor doesn't answer are normal.
deadline=$(( $(date +%s) + minutes * 60 )); silent=0
while [ "$(date +%s)" -lt "$deadline" ]; do
  if [ -f "$report" ] && [ "$(head -n 1 "$report")" = "$run done" ]; then
    tail -n +2 "$report"
    case $(sed -n 2p "$report") in "no test:"*) exit 5 ;; "not ready:"*) exit 2 ;; esac
    exit 0
  fi
  sleep 3
  if unity command --timeout 10 editor status --result-only >/dev/null 2>&1; then silent=0
  else silent=$((silent + 1)); [ "$silent" -ge 20 ] && not_answering
  fi
done
echo "still running after $minutes minutes (the outcome will be in $report)"; exit 4
